root = true

# 모든 파일 공통
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 들여쓰기: space 기반 (웹/Flutter/Python 공통 안전값)
indent_style = space
indent_size = 2

# Markdown은 trailing whitespace 유지 (렌더링 목적)
[*.md]
trim_trailing_whitespace = false

# YAML은 들여쓰기 민감 → 명시
[*.yml]
indent_size = 2
